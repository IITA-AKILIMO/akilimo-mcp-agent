// SQLite schema. Keep the models in sync with ../pgsql/schema.prisma (only column types differ)
// and create a migration for both when changing them; see AGENTS.md.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/sqlite"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at")
  sessions      Session[]
  conversations Conversation[]
  activity      Activity[]

  @@map("users")
}

// Only a SHA-256 of the session token is stored, so a database leak does not expose sessions
model Session {
  tokenHash String   @id @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId])
  @@map("sessions")
}

model Conversation {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  model     String?
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  messages  Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

// The full model history, including tool calls and tool results, so a reopened chat keeps its context
model Message {
  id             Int          @id @default(autoincrement())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @default("")
  toolCalls      Json?        @map("tool_calls")
  toolName       String?      @map("tool_name")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, id])
  @@map("messages")
}

model Activity {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  server    String
  message   String
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, id(sort: Desc)])
  @@map("activity")
}
