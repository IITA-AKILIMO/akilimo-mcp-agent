{
  "name": "@akilimo/server",
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite-node src/index.ts",
    "dev:http": "node --watch-path=src --watch-path=../shared/src node_modules/vite-node/vite-node.mjs src/index.ts -- --http",
    "build": "vite build",
    "start": "node dist/index.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "vite-node src/index.ts -- --migrate",
    "seed:admin": "vite-node src/index.ts -- --seed-admin"
  },
  "dependencies": {
    "@akilimo/llm": "workspace:*",
    "@akilimo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.3.2",
    "axios": "^1.7.0",
    "cors": "^2.8.6",
    "drizzle-orm": "0.45.4",
    "express": "^5.0.0",
    "pg": "8.23.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-node": "^2.0.0"
  }
}
