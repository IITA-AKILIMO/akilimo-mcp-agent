{
  "name": "@akilimo/server",
  "version": "1.0.0",
  "main": "dist/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite-node src/index.ts",
    "dev:http": "pnpm db:generate && pnpm db:migrate && node --watch-path=src --watch-path=../shared/src node_modules/vite-node/vite-node.mjs src/index.ts -- --http",
    "build": "pnpm db:generate && vite build",
    "start": "node dist/index.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate.mjs",
    "seed:admin": "pnpm db:generate && vite-node src/index.ts -- --seed-admin"
  },
  "dependencies": {
    "@akilimo/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.3.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "axios": "^1.7.0",
    "cors": "^2.8.6",
    "express": "^5.0.0",
    "prisma": "7.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-node": "^2.0.0"
  }
}
