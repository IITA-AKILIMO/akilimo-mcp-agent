# Akilimo 1.0 API (new-akilimo-api): https://api.akilimo.org, or http://localhost:8600 when running it locally
AKILIMO_API_BASE_URL=https://api.akilimo.org
# Optional: only protected Akilimo API routes need a key (reference data and compute are public)
AKILIMO_API_KEY=
# Optional: fixed device UUID sent as user_info.device_token; a random one is generated per start otherwise
AKILIMO_DEVICE_TOKEN=
# Browser origins allowed to call the MCP server directly (the web UI goes through its same-origin proxy)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# docker compose: required by Open WebUI
WEBUI_SECRET_KEY=
# docker compose: Ollama on the host; see README for WSL + Windows
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Set by docker compose / the Dockerfile. Locally the server uses stdio unless started with
# `pnpm dev:server:http`, and listens on port 3001 by default.
# TRANSPORT=http
# PORT=3001
