# Akilimo 1.0 API (new-akilimo-api): https://api.akilimo.org, or http://localhost:8600 when running it locally
AKILIMO_API_BASE_URL=https://api.akilimo.org
# Optional: this server's key for the Akilimo API. Reference data and compute are public; the key is
# needed to accept MCP keys users create in the API's playground (ak_..., see MCP_REQUIRE_KEY), and
# then must have the mcp:verify-keys ability (an API admin creates it).
AKILIMO_API_KEY=
# Optional: fixed device UUID sent as user_info.device_token; a random one is generated per start otherwise
AKILIMO_DEVICE_TOKEN=
# Browser origins allowed to call the MCP server directly (the web UI goes through its same-origin proxy).
# /mcp, /sse and /messages answer 403 to any other Origin; clients that send none (not browsers) pass.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Optional: client keys for the MCP endpoints, comma-separated (generate with: openssl rand -hex 32).
# When set, /mcp and /sse need one as `Authorization: Bearer <key>` or `X-API-Key: <key>`, like Akilimo 2.0;
# a request with a valid key skips the Origin check. Empty = public endpoints. The server's own chat and
# gateway calls over 127.0.0.1 need no key; Open WebUI and other clients do.
MCP_API_KEYS=
# Optional: true = /mcp and /sse refuse requests without a key even when MCP_API_KEYS is empty, so only
# MCP keys users create in the Akilimo API's playground (ak_..., type "MCP key") get in; they are
# checked by the API, so AKILIMO_API_KEY must be set. Such a key or an MCP_API_KEYS key is accepted
# either way; answers from the API are cached for a minute.
MCP_REQUIRE_KEY=
# Optional: per client IP and minute on /mcp, /sse and /messages (default 120), and compute_recommendations
# calls among them (default 10); the server's own calls over 127.0.0.1 are not limited
MCP_RATE_LIMIT=
MCP_COMPUTE_RATE_LIMIT=
# Optional: open legacy SSE sessions in total (default 200) and per client IP (default 5); idle ones close after 30 minutes
SSE_MAX_SESSIONS=
SSE_MAX_SESSIONS_PER_IP=

# MCP server list (HTTP mode): with a database it is the table mcp_servers, filled with the default
# servers on the first start and edited by admins in the UI. Only on that first start, an older
# registry file at this path (default packages/server/data/mcp-servers.json) is imported instead of
# the defaults. Without a database the list is read-only and read from this file if it exists.
# GATEWAY_DATA_FILE=

# User accounts, saved chats and activity (PostgreSQL). Leave DB_HOST empty for guest-only use.
# Migrations (Drizzle, packages/server/drizzle) are applied by the server whenever it connects.
# docker compose: DB_HOST=db uses the bundled PostgreSQL, created from these same values.
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_SCHEMA=
DB_USERNAME=
DB_PASSWORD=

# Optional admin account, ensured on every start (and by `pnpm seed:admin`): created if missing,
# an existing account with this email is promoted; an existing password is never changed.
# Admins manage the MCP server list and user roles in the web UI (Manage). Remove the password
# from the environment once the account exists if you prefer.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
# Optional; without it the username comes from the email (e.g. admin@example.org -> admin)
ADMIN_USERNAME=

# Master key for the secrets saved in the database: LLM provider keys and MCP server keys are
# encrypted with it (AES-256-GCM). Generate: openssl rand -base64 32. Keep it safe and stable: a
# different key cannot read keys saved earlier. Without it the chat only works with Ollama.
SECRETS_KEY=
# Ollama the server calls for the chat (default http://127.0.0.1:11434); also used by docker compose
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional web search for the Ask AI chat. Admins normally set it up in Manage > AI providers > Web search (key stored encrypted); these variables are only the fallback when no admin setting exists. Without either the globe button does not appear. Even when set,
# search is off until the user turns it on for a conversation, and the model's search text is sent to the service.
# SEARCH_PROVIDER=brave        # brave, tavily, serper or searxng
# SEARCH_API_KEY=              # for brave, tavily or serper
# SEARCH_URL=                  # base URL of a SearXNG instance (JSON format enabled)
# Exchange rates for converting prices to the local currency (default: the free open.er-api.com, no key;
# same JSON shape if you change it)
# EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD
# Rough token budget of the conversation history sent to ANY provider (default 10000, tools come on top). Older
# tool results are shortened, then dropped, to stay under it; the farmer's own words are always kept.
# CHAT_CONTEXT_TOKENS=10000
# Context window sent to Ollama (default 16384 tokens); lower it on a small GPU, but a window that is too
# small makes the assistant forget what was said earlier in the conversation
# OLLAMA_NUM_CTX=16384
# Sources of the tools get_soil_profile (ISRIC SoilGrids) and get_climate_summary (NASA POWER); both need no key. Set these to point
# to a copy of the service that you host yourself (same routes), e.g. when the public SoilGrids service is busy.
# SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0
# POWER_URL=https://power.larc.nasa.gov/api/temporal/monthly/point

# docker compose: required by Open WebUI
WEBUI_SECRET_KEY=
# Ollama on the host with Docker in WSL + Windows: see README

# Set by docker compose / the Dockerfile. Locally the server uses stdio unless started with
# `pnpm dev:server:http`, and listens on port 3001 by default.
# TRANSPORT=http
# PORT=3001
