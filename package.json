{
  "name": "akilimo-mcp-monorepo",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "scripts": {
    "dev:server": "pnpm --filter @akilimo/server dev",
    "dev:server:http": "pnpm --filter @akilimo/server dev:http",
    "dev:web": "pnpm --filter @akilimo/web dev",
    "build": "pnpm --filter \"@akilimo/*\" build",
    "start": "pnpm --filter @akilimo/server start",
    "db:migrate": "pnpm --filter @akilimo/server db:migrate",
    "seed:admin": "pnpm --filter @akilimo/server seed:admin"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
